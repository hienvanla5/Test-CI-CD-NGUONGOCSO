<+><!DOCTYPE html>\r\n<html lang=\"vi\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Nguồn Gốc Số - Đăng nhập</title>\r\n    <!-- Google Fonts: Outfit -->\r\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\r\n    <!-- Main Stylesheet -->\r\n    <link rel=\"stylesheet\" href=\"style.css\">\r\n</head>\r\n<body>\r\n    <div class=\"background-decorations\">\r\n        <div class=\"circle circle-1\"></div>\r\n        <div class=\"circle circle-2\"></div>\r\n    </div>\r\n\r\n    <main class=\"app-container\">\r\n        <!-- Container đăng nhập -->\r\n        <section id=\"login-section\" class=\"glass-card\">\r\n            <div class=\"brand-header\">\r\n                <div class=\"logo\">\r\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\r\n                        <path d=\"M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5\"/>\r\n                    </svg>\r\n                </div>\r\n                <h1>Nguồn Gốc Số</h1>\r\n                <p>Số hóa chuỗi cung ứng nông nghiệp</p>\r\n            </div>\r\n\r\n            <form id=\"login-form\">\r\n                <div class=\"input-group\">\r\n                    <label for=\"username\">Tên đăng nhập</label>\r\n                    <div class=\"input-wrapper\">\r\n                        <svg class=\"input-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\r\n                            <path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"/>\r\n                            <circle cx=\"12\" cy=\"7\" r=\"4\"/>\r\n                        </svg>\r\n                        <input type=\"text\" id=\"username\" placeholder=\"Nhập tên tài khoản\" required autocomplete=\"username\">\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"input-group\">\r\n                    <label for=\"password\">Mật khẩu</label>\r\n                    <div class=\"input-wrapper\">\r\n                        <svg class=\"input-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\r\n                            <rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"/>\r\n                            <path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/>\r\n                        </svg>\r\n                        <input type=\"password\" id=\"password\" placeholder=\"Nhập mật khẩu\" required autocomplete=\"current-password\">\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"input-group\">\r\n                    <label for=\"organizationCode\">\r\n                        Mã tổ chức <span class=\"optional-tag\">(Tùy chọn)</span>\r\n                    </label>\r\n                    <div class=\"input-wrapper\">\r\n                        <svg class=\"input-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\r\n                            <rect x=\"2\" y=\"7\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"/>\r\n                            <path d=\"M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"/>\r\n                        </svg>\r\n                        <input type=\"text\" id=\"organizationCode\" placeholder=\"Ví dụ: HTX_AN_BINH\">\r\n                    </div>\r\n                </div>\r\n\r\n                <div id=\"error-message\" class=\"error-banner hidden\">\r\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\r\n                        <circle cx=\"12\" cy=\"12\" r=\"10\"/>\r\n                        <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"/>\r\n                        <line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"/>\r\n                    </svg>\r\n                    <span class=\"msg-content\">Sai thông tin đăng nhập</span>\r\n                </div>\r\n\r\n                <button type=\"submit\" id=\"submit-btn\" class=\"primary-btn\">\r\n                    <span class=\"btn-text\">Đăng nhập</span>\r\n                    <span class=\"spinner hidden\"></span>\r\n                </button>\r\n            </form>\r\n        </section>\r\n\r\n        <!-- Container Dashboard khi đăng nhập thành công -->\r\n        <section id=\"profile-section\" class=\"glass-card hidden\">\r\n            <div class=\"success-header\">\r\n                <div class=\"success-badge\">\r\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\">\r\n                        <polyline points=\"20 6 9 17 4 12\"/>\r\n                    </svg>\r\n                </div>\r\n                <h2>Kết nối thành công!</h2>\r\n                <p>Thông tin tài khoản đăng nhập hiện tại</p>\r\n            </div>\r\n\r\n            <div class=\"profile-info\">\r\n                <div class=\"info-row\">\r\n                    <span class=\"info-label\">Họ tên:</span>\r\n                    <span id=\"profile-fullname\" class=\"info-value\">-</span>\r\n                </div>\r\n                <div class=\"info-row\">\r\n                    <span class=\"info-label\">Tài khoản:</span>\r\n                    <span id=\"profile-username\" class=\"info-value\">-</span>\r\n                </div>\r\n                <div class=\"info-row\">\r\n                    <span class=\"info-label\">Vai trò:</span>\r\n                    <span id=\"profile-role\" class=\"info-value badge\">-</span>\r\n                </div>\r\n                <div class=\"info-row\">\r\n                    <span class=\"info-label\">Tổ chức:</span>\r\n                    <span id=\"profile-orgname\" class=\"info-value\">-</span>\r\n                </div>\r\n                <div class=\"info-row\">\r\n                    <span class=\"info-label\">Mã tổ chức:</span>\r\n                    <span id=\"profile-orgcode\" class=\"info-value code\">-</span>\r\n                </div>\r\n            </div>\r\n\r\n            <button id=\"logout-btn\" class=\"secondary-btn\">\r\n                <span>Đăng xuất</span>\r\n            </button>\r\n        </section>\r\n    </main>\r\n\r\n    <!-- App Logic -->\r\n    <script src=\"app.js\"></script>\r\n</body>\r\n</html>\r\n
